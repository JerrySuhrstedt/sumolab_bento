---
const benefits = [
	{
		title: "Senior marketing leadership from day one.",
		body: "No onboarding lag, no learning curve. I've run this function inside real companies — as your part-time CMO, I own the strategy, direct the vendors, and hold execution accountable from week one.",
	},
	{
		title: "AI used where it pays, ignored where it doesn't.",
		body: "I went deep on AI three years ago as an operator, not a technologist. I know which tools move revenue and which ones just add noise. You get the results without the science projects.",
	},
	{
		title: "An operator who's been in your seat.",
		body: "Twelve companies, 28 years, every function. I don't advise from the outside — I've made payroll, managed vendors, built sales teams, and fixed what was broken. That's the judgment I bring to your marketing.",
	},
];
---
<div class="card">
	<div class="eyebrow">Benefits</div>
	<h2>What you get when you hire a fractional CMO.</h2>
	<div class="tiles">
		{benefits.map((b) => (
			<div class="tile">
				<h3>{b.title}</h3>
				<p>{b.body}</p>
			</div>
		))}
	</div>
	<div class="photo-band">
		<img src="/photos/team-diverse-office-2.jpg" alt="Business team collaborating on marketing strategy in a modern office" class="photo-bg" />
		<div class="photo-overlay">
			<p>One person. Full marketing ownership. Results you can measure.</p>
		</div>
	</div>
</div>

<style>
	.card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 1.1;
		margin: 0 0 32px;
		max-width: 700px;
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin-bottom: 24px;
	}
	.tile {
		background: var(--surface-sunken);
		border-radius: var(--radius-md);
		padding: 26px;
	}
	.tile h3 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 17px;
		margin: 0 0 10px;
	}
	.tile p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0;
	}
	.photo-band {
		position: relative;
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.photo-bg {
		width: 100%;
		height: 520px;
		object-fit: cover;
		display: block;
		background: var(--grey-400);
	}
	.photo-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(16, 16, 18, 0.75), transparent 60%);
		display: flex;
		align-items: flex-end;
		padding: 24px;
	}
	.photo-overlay p {
		color: #fff;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 18px;
		max-width: 480px;
		margin: 0;
	}
	@media (max-width: 780px) {
		.tiles {
			grid-template-columns: 1fr;
		}
		.card {
			padding: 32px 24px;
		}
		h2 {
			font-size: 2.25rem;
			line-height: 1.15;
		}
	}
</style>
