---
const columns = [
	{ h: 'Company', items: ['About', 'Approach', "Who It's For", 'Case Studies', 'Insights', 'Contact'] },
	{ h: 'Services', items: ['Fractional CMO', 'Fractional Marketing Director', 'Fractional AI Advisor'] },
	{ h: 'Connect', items: ['jerry@sumolab.co', '(480) 826-9400', 'Chandler, Arizona'] },
];
---
<footer class="footer">
	<div class="grid">
		<div>
			<img src="/images/sumolab-logo.svg" alt="SumoLab" class="logo" />
			<p class="tagline">
				Senior marketing leadership for established businesses ready to turn scattered activity into
				focused growth.
			</p>
		</div>
		{columns.map((col) => (
			<div>
				<div class="col-h">{col.h}</div>
				<div class="col-items">
					{col.items.map((t) => <span>{t}</span>)}
				</div>
			</div>
		))}
	</div>
	<div class="bottom">
		<span>© 2026 SumoLab LLC. All rights reserved.</span>
		<div class="legal">
			<span>Privacy Policy</span>
			<span>Terms</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--hairline);
	}
	.grid {
		max-width: 1180px;
		margin: 0 auto;
		padding: 48px 40px;
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 32px;
	}
	.logo {
		height: 22px;
		margin-bottom: 16px;
	}
	.tagline {
		font-size: 14px;
		color: var(--text-secondary);
		line-height: 1.6;
		max-width: 260px;
	}
	.col-h {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 14px;
	}
	.col-items {
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 14px;
	}
	.bottom {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 40px 32px;
		display: flex;
		justify-content: space-between;
		font-size: 13px;
		color: var(--text-muted);
	}
	.legal {
		display: flex;
		gap: 20px;
	}
	@media (max-width: 780px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.bottom {
			flex-direction: column;
			gap: 12px;
		}
	}
</style>
