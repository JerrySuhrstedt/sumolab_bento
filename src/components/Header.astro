---
const links = ['Services', 'Approach', "Who It's For", 'Case Studies', 'About', 'Insights', 'Contact'];
---
<header class="header">
	<img src="/images/sumolab-logo.svg" alt="SumoLab" class="logo" />
	<nav class="nav">
		{links.map((l) => <a href="#">{l}</a>)}
	</nav>
	<a href="#" class="cta">Book a Strategy Call→</a>
</header>

<style>
	.header {
		position: relative;
		z-index: 2;
		max-width: 1180px;
		width: 100%;
		margin: 0 auto;
		padding: 28px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}
	.logo {
		height: 24px;
		filter: brightness(0) invert(1);
	}
	.nav {
		display: flex;
		gap: 26px;
		font-size: 14px;
		font-weight: 500;
		flex-wrap: wrap;
	}
	.nav a {
		color: #fff;
	}
	.nav a:hover {
		color: var(--orange-100);
	}
	.cta {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 14px;
		background: var(--orange-500);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 12px 20px;
		white-space: nowrap;
	}
	.cta:hover {
		background: var(--orange-600);
		color: #fff;
	}
</style>
