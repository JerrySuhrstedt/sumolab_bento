---
const features = [
	'Fractional CMO Leadership',
	'Lead Generation Systems',
	'Marketing Strategy And Roadmap',
	'CRM And Marketing Automation',
	'Brand And Messaging Alignment',
	'AI Opportunity Mapping And Implementation',
	'Agency And Vendor Oversight',
	'Weekly Or Biweekly Leadership Cadence',
	'Funnel And Conversion Review',
	'KPI Definition And Reporting',
];
---
<div class="card about">
	<div class="portrait-wrap">
		<img src="/team/jerry-suhrstedt-cutout.png" alt="Jerry Suhrstedt, founder and fractional CMO at SumoLab" class="portrait" loading="lazy" />
	</div>
	<div class="about-content">
		<div class="eyebrow">About</div>
		<h2>26 years of running businesses. Not advising about them.</h2>
		<p>
			26 years of building, running, and rescuing companies (twelve of them) across marketing,
			technology, construction, and professional services. Fractional CMO and marketing operator
			who uses AI to help $5M–$50M businesses grow faster than their competition. Based in
			Chandler, Arizona. If you're searching for a{' '}
			<a href="/fractional-cmo-near-me/">fractional CMO near you</a>, start there.
		</p>
		<a href="/about/" class="link">About Jerry →</a>
	</div>
</div>

<div class="card features">
	<div class="eyebrow">What's Included</div>
	<h2>One engagement. The whole marketing function.</h2>
	<div class="list">
		{features.map((t) => (
			<div class="item">
				<span class="dot"></span>
				{t}
			</div>
		))}
	</div>
</div>

<style>
	.card {
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 1.1;
		margin: 0 0 16px;
	}
	.about {
		background: var(--ink-950);
		color: #fff;
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		align-items: stretch;
		min-height: 480px;
		padding: 0;
		overflow: hidden;
	}
	.portrait-wrap {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: 100%;
	}
	.portrait {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
	}
	.about-content {
		padding: 48px 48px 48px 0;
	}
	.about p {
		font-size: 15px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0 0 24px;
		max-width: 480px;
	}
	.link {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		color: var(--orange-500);
	}
	.features {
		background: var(--white);
		border: 1px solid var(--border);
	}
	.features h2 {
		margin-bottom: 6px;
	}
	.sub {
		font-size: 16px;
		color: var(--text-muted);
		margin: 0 0 28px;
	}
	.list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px 32px;
	}
	.item {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		font-size: 15px;
		font-weight: 500;
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--orange-500);
		margin-top: 7px;
		flex: none;
	}
	@media (max-width: 780px) {
		.about {
			grid-template-columns: 1fr;
			min-height: 0;
		}
		.portrait-wrap {
			height: 360px;
		}
		.about-content {
			padding: 32px 24px;
		}
		.features {
			padding: 32px 24px;
		}
		h2 {
			font-size: 2.25rem;
			line-height: 1.15;
		}
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
