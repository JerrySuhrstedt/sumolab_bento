---
const features = [
	'Fractional CMO Leadership',
	'Funnel And Conversion Review',
	'Marketing Strategy And Roadmap',
	'CRM And Marketing System Optimization',
	'Brand And Messaging Alignment',
	'AI And Automation Opportunity Mapping',
	'Agency And Vendor Oversight',
	'Weekly Or Biweekly Leadership Cadence',
	'KPI Definition And Reporting',
];
---
<div class="card about">
	<img src="/images/jerry-suhrstedt.png" alt="Jerry Suhrstedt" class="portrait" />
	<div>
		<div class="eyebrow">About</div>
		<h2>Hi, I'm Jerry Suhrstedt.</h2>
		<p>
			26 years of experience as an entrepreneur, marketing leader, and business consultant, helping
			established businesses develop and execute high-impact marketing strategies without the
			commitment of a full-time hire.
		</p>
		<a href="#" class="link">About Jerry→</a>
	</div>
</div>

<div class="card features">
	<div class="eyebrow">Features</div>
	<h2>We feature.</h2>
	<p class="sub">Simple. Logical.</p>
	<div class="list">
		{features.map((t) => (
			<div class="item">
				<span class="dot"></span>
				{t}
			</div>
		))}
	</div>
</div>

<style>
	.card {
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 3.875rem;
		margin: 0 0 16px;
	}
	.about {
		background: var(--ink-950);
		color: #fff;
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 40px;
		align-items: center;
	}
	.portrait {
		width: 100%;
		height: 260px;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--grey-400);
	}
	.about p {
		font-size: 15px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0 0 24px;
		max-width: 480px;
	}
	.link {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		color: var(--orange-500);
	}
	.features {
		background: var(--white);
		border: 1px solid var(--border);
	}
	.features h2 {
		margin-bottom: 6px;
	}
	.sub {
		font-size: 16px;
		color: var(--text-muted);
		margin: 0 0 28px;
	}
	.list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px 32px;
	}
	.item {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		font-size: 15px;
		font-weight: 500;
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--orange-500);
		margin-top: 7px;
		flex: none;
	}
	@media (max-width: 780px) {
		.about {
			grid-template-columns: 1fr;
		}
		.card {
			padding: 32px 24px;
		}
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
