---
interface Props {
	image: string;
	mobileImage?: string;
	imageAlt?: string;
	eyebrow: string;
	align?: "left" | "right";
	imagePosition?: string;
}

const { image, mobileImage, imageAlt = "", eyebrow, align = "left", imagePosition = "center" } = Astro.props;
const srcset = mobileImage ? `${mobileImage} 800w, ${image} 1600w` : undefined;
const sizes = srcset ? "(min-width: 1260px) 1180px, 100vw" : undefined;
const toWebp = (path: string) => path.replace(/\.jpe?g$/i, ".webp");
const webpSrcset = mobileImage ? `${toWebp(mobileImage)} 800w, ${toWebp(image)} 1600w` : undefined;
---

<section class="page-hero-wrap">
	<div class:list={["page-hero", align]}>
		<picture>
			{webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
			<img
				src={image}
				srcset={srcset}
				sizes={sizes}
				alt={imageAlt}
				class="bg"
				style={`object-position: ${imagePosition}`}
				fetchpriority="high"
			/>
		</picture>
		<div class="overlay" aria-hidden="true"></div>
		<div class="content">
			<p class="eyebrow">
				<span class="dot" aria-hidden="true"></span>
				{eyebrow}
			</p>
			<slot />
		</div>
	</div>
</section>

<style>
	.page-hero-wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 24px 40px 24px;
	}
	.page-hero {
		position: relative;
		border-radius: var(--radius-lg);
		overflow: hidden;
		min-height: 460px;
		display: flex;
		align-items: flex-end;
	}
	.page-hero.right {
		justify-content: flex-end;
	}
	.bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(16, 16, 18, 0.55), rgba(16, 16, 18, 0.35) 40%, rgba(16, 16, 18, 0.82));
	}
	.content {
		position: relative;
		z-index: 1;
		padding: 48px;
		max-width: 720px;
	}
	.page-hero.right .content {
		text-align: right;
		margin-left: auto;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-100);
		margin: 0 0 16px;
	}
	.page-hero.right .eyebrow {
		justify-content: flex-end;
	}
	.dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: currentColor;
	}
	:global(.page-hero h1) {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 3.5rem;
		line-height: 1.05;
		color: #fff;
		margin: 0 0 16px;
	}
	:global(.page-hero p) {
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
		margin: 0;
	}
	@media (max-width: 640px) {
		.page-hero-wrap {
			padding: 16px 20px 16px;
		}
		.content {
			padding: 32px 24px;
		}
		:global(.page-hero h1) {
			font-size: 2.25rem;
		}
	}
</style>
