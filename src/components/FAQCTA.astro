---
import CTAForm from './CTAForm.astro';

const faqs = [
	{
		q: 'What is a fractional CMO?',
		a: 'A fractional CMO — a fractional chief marketing officer — is a senior marketing executive who leads your strategy, budget, vendors, and team on a part-time basis. You get proven marketing leadership and accountability for revenue, without adding a full-time executive to your payroll.',
	},
	{
		q: 'What does a fractional CMO cost compared to a full-time hire?',
		a: 'A full-time CMO costs $150,000–$300,000 per year once salary, benefits, bonuses, and overhead are included, plus 6–9 months before they\'re fully productive. Fractional CMO cost is a fraction of that: you pay only for the leadership time you need, get productivity from week one, and carry no long-term payroll commitment.',
	},
	{
		q: 'Who should hire a fractional CMO?',
		a: 'Established businesses generating $5M–$50M in revenue that have outgrown tactical marketing but aren\'t ready — or don\'t need — a full-time marketing executive. You likely have a coordinator or an agency, but no one owning the strategy and connecting it to revenue. That\'s the gap I close.',
	},
	{
		q: 'Is this the same as hiring an agency?',
		a: 'No. Agencies execute deliverables — ads, content, websites. I own the strategy that tells the agency what to build and holds them accountable for results. Most agency relationships fail because no one connects their output to your business goals. I am that connection.',
	},
	{
		q: 'Will you do the work or just advise?',
		a: 'Both, in proportion to what\'s needed. I lead the strategy, make the decisions, and own the outcomes — and I step in on systems, CRM, content, and AI implementation when execution is the constraint. When the gap is more operational than executive, a <a href="/services/fractional-marketing-director/">fractional marketing director</a> engagement fits better: same model, closer to the day-to-day.',
	},
	{
		q: 'Is AI actually practical for my business right now?',
		a: 'For most $5M–$50M businesses, yes — but only when it\'s aimed at the right problem. The companies getting real return from AI aren\'t the ones who bought the most tools; they\'re the ones with someone who knew where to point them. That\'s what I do, within the CMO engagement or as a dedicated <a href="/services/fractional-ai-advisor/">AI marketing consultant</a>.',
	},
	{
		q: 'How quickly will I see results?',
		a: 'Most clients get strategic clarity within the first 30 days — clear positioning, aligned messaging, a prioritized roadmap. Revenue impact from lead generation typically shows in 60–90 days depending on your sales cycle. The first conversation is free, and I\'ll tell you honestly if this is the right fit.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.a.replace(/<[^>]+>/g, ''),
		},
	})),
};
---
<div class="card faq">
	<div class="eyebrow">FAQs</div>
	<h2>Questions about hiring a fractional CMO.</h2>
	<div class="list">
		{faqs.map((item, index) => (
			<details class="item" open={index === 0}>
				<summary class="q">
					<span>{item.q}</span>
					<span class="icon" aria-hidden="true">+</span>
				</summary>
				<div class="a" set:html={item.a} />
			</details>
		))}
	</div>
</div>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<div class="final-cta">
	<h2>Ready to turn your marketing into a revenue engine?</h2>
	<CTAForm />
</div>

<style>
	.card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	.faq h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 1.1;
		margin: 0 0 28px;
	}
	.list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--hairline);
	}
	.item {
		padding: 18px 0;
		border-bottom: 1px solid var(--hairline);
	}
	.q {
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 16px;
		color: var(--text-primary);
	}
	.q::-webkit-details-marker {
		display: none;
	}
	.icon {
		color: var(--orange-500);
		font-size: 20px;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}
	.item[open] .icon {
		transform: rotate(45deg);
	}
	.a {
		margin: 12px 0 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	.final-cta {
		background: var(--ink-950);
		border-radius: var(--radius-lg);
		padding: 64px 48px;
		margin-bottom: 24px;
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 40px;
		align-items: center;
	}
	.final-cta h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 34px;
		line-height: 1.2;
		color: #fff;
		margin: 0;
	}
	@media (max-width: 780px) {
		.final-cta {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.card,
		.final-cta {
			padding: 32px 24px;
		}
		h2 {
			font-size: 2.25rem;
			line-height: 1.15;
		}
	}
</style>
