---
const faqs = [
	{
		q: 'How is this different from hiring a full-time Director of Marketing or CMO?',
		a: 'A full-time CMO costs $150,000–$300,000 per year before benefits and overhead, plus 6–9 months before they\'re fully productive. With SumoLab, you get the same senior-level leadership at a fraction of the cost, with no long-term payroll commitment. I\'m productive from week one. If your needs grow, we scale the engagement. If priorities shift, there\'s no severance conversation.',
	},
	{
		q: 'Who is this for?',
		a: 'Established businesses generating $5M–$50M in revenue that have outgrown tactical marketing but aren\'t ready — or don\'t need — a full-time marketing executive. You likely have a marketing coordinator or an agency vendor, but no one owning the strategy. That\'s the gap I close.',
	},
	{
		q: 'Is this the same as hiring an agency?',
		a: 'No. Agencies execute deliverables — content, ads, websites. I own the strategy that tells the agency what to build and holds them accountable for results. Most agency relationships fail because no one connects their output to your business goals. I am that connection.',
	},
	{
		q: 'Will you do the work or just advise?',
		a: 'Both, in proportion to what\'s needed. I lead the strategy, make the decisions, and own the outcomes. I also step in on systems, CRM, and content when execution is the constraint. The goal is progress, not slide decks.',
	},
	{
		q: 'How quickly will I see results?',
		a: 'Most clients get strategic clarity within the first 30 days — clear positioning, aligned messaging, and a prioritized roadmap. Revenue impact from lead generation and campaigns typically shows up in 60–90 days, depending on your sales cycle. The first conversation is free, and I\'ll tell you honestly if this is the right fit.',
	},
];
---
<div class="card faq">
	<div class="eyebrow">FAQs</div>
	<h2>Common questions.</h2>
	<div class="list">
		{faqs.map((item) => (
			<div class="item">
				<div class="q">{item.q}</div>
				<div class="a">{item.a}</div>
			</div>
		))}
	</div>
</div>

<div class="final-cta">
	<h2>Ready to stop spending on activity and start investing in results?</h2>
	<a href="/contact" class="cta">Book a Strategy Call →</a>
</div>

<style>
	.card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	.faq h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 1.1;
		margin: 0 0 28px;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.item {
		padding: 18px 0;
		border-top: 1px solid var(--hairline);
	}
	.item:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.q {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 16px;
		margin-bottom: 8px;
	}
	.a {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	.final-cta {
		background: var(--ink-950);
		border-radius: var(--radius-lg);
		padding: 64px 48px;
		text-align: center;
		margin-bottom: 24px;
	}
	.final-cta h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 34px;
		line-height: 1.2;
		color: #fff;
		max-width: 560px;
		margin: 0 auto 28px;
	}
	.final-cta .cta {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		background: var(--orange-500);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 14px 26px;
	}
	.final-cta .cta:hover {
		background: var(--orange-600);
		color: #fff;
	}
	@media (max-width: 640px) {
		.card,
		.final-cta {
			padding: 32px 24px;
		}
		h2 {
			font-size: 2.25rem;
			line-height: 1.15;
		}
	}
</style>
