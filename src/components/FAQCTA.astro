---
const faqs = [
	{ q: 'How is this different from hiring a full-time Director of Marketing or CMO?', a: 'You get senior-level leadership without salary, benefits, onboarding time, or long-term risk. You gain experience and perspective immediately, with flexibility to scale up or down as your business needs change.' },
	{ q: 'Who is this for?', a: 'Established businesses that want growth, clarity, and accountability. Typical clients we work with generate $5M+ in revenue.' },
	{ q: 'Is this the same as hiring an agency?', a: 'No. Agencies execute tasks. I own the strategy and hold execution accountable.' },
	{ q: 'Will you do the work or just advise?', a: 'I lead, guide, and step in where needed. The goal is progress, not busywork.' },
];
---
<div class="card faq">
	<div class="eyebrow">FAQs</div>
	<h2>Questions answered.</h2>
	<div class="list">
		{faqs.map((item) => (
			<div class="item">
				<div class="q">{item.q}</div>
				<div class="a">{item.a}</div>
			</div>
		))}
	</div>
</div>

<div class="final-cta">
	<h2>Ready to stop guessing and start owning your marketing?</h2>
	<a href="#" class="cta">Book a Strategy Call→</a>
</div>

<style>
	.card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	.faq h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 3.8rem;
		margin: 0 0 28px;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.item {
		padding: 18px 0;
		border-top: 1px solid var(--hairline);
	}
	.item:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.q {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 16px;
		margin-bottom: 8px;
	}
	.a {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	.final-cta {
		background: var(--ink-950);
		border-radius: var(--radius-lg);
		padding: 64px 48px;
		text-align: center;
		margin-bottom: 24px;
	}
	.final-cta h2 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 34px;
		line-height: 1.2;
		color: #fff;
		max-width: 560px;
		margin: 0 auto 28px;
	}
	.final-cta .cta {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		background: var(--orange-500);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 14px 26px;
	}
	.final-cta .cta:hover {
		background: var(--orange-600);
		color: #fff;
	}
	@media (max-width: 640px) {
		.card,
		.final-cta {
			padding: 32px 24px;
		}
		h2 {
			font-size: 2.25rem;
			line-height: 1.15;
		}
	}
</style>
