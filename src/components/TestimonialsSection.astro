---
const quotes = [
	{ photo: '/team/alek-synkevych.jpg', name: 'Alek Synkevych', role: 'CEO, RevBit', quote: "Jerry's mentorship, approachable nature, and positive attitude stand out. He is an excellent mentor and coach.", dark: false },
	{ photo: '/team/khero-witey.jpg', name: 'Khero Witey', role: 'Associate VP, Third Republic', quote: 'Jerry is one of a kind, talks the talk and actually backs it up by walking the walk!', dark: true },
	{ photo: '/team/jonathan-cisneros.jpg', name: 'Jonathan Cisneros', role: 'Agency Owner', quote: 'It’s rare to find an individual as knowledgeable and driven as Jerry. I would line up to have him on my team any day.', dark: false },
	{ photo: '/team/doug-crew.jpg', name: 'Doug Crew', role: 'Systems Consultant', quote: 'His skills, work ethic, and collaborative spirit contribute to the success of any organization.', dark: false },
];
---
<div class="card">
	<div class="heading">
		<div class="eyebrow">What clients say</div>
		<h2>Don't take our word for it.</h2>
	</div>
	<div class="grid">
		{quotes.map((q) => (
			<div class={`tile ${q.dark ? 'dark' : ''}`}>
				<img src={q.photo} alt={q.name} class="avatar" />
				<div class="stars" aria-hidden="true">★★★★★</div>
				<p class="quote">"{q.quote}"</p>
				<div class="name">{q.name}</div>
				<div class="role">{q.role}</div>
			</div>
		))}
	</div>
</div>

<style>
	.card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 48px;
		margin-bottom: 24px;
	}
	.heading {
		text-align: center;
		margin-bottom: 32px;
	}
	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin-bottom: 16px;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 4rem;
		line-height: 3.8rem;
		margin: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}
	.tile {
		background: var(--surface-sunken);
		border-radius: var(--radius-md);
		padding: 22px;
	}
	.tile.dark {
		background: var(--ink-950);
		color: #fff;
	}
	.avatar {
		width: 40px;
		height: 40px;
		border-radius: 999px;
		object-fit: cover;
		margin-bottom: 14px;
		display: block;
	}
	.stars {
		color: var(--orange-500);
		font-size: 12px;
		letter-spacing: 2px;
		margin-bottom: 10px;
	}
	.quote {
		font-size: 13px;
		line-height: 1.5;
		margin: 0 0 14px;
	}
	.name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 13px;
	}
	.role {
		font-size: 12px;
		color: var(--text-muted);
	}
	.tile.dark .role {
		color: rgba(255, 255, 255, 0.55);
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.card {
			padding: 32px 24px;
		}
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
