---
const points = [
	'Turn Marketing Chaos Into Predictable Revenue',
	'Aim AI At The Problems That Actually Pay',
	'Hire a Fractional CMO Without the Full-Time Cost',
];
---
<div class="hero">
	<video autoplay muted loop playsinline poster="/photos/hero-entrepreneur-office-v3.jpg" class="hero-bg">
		<source src="/videos/hero-office-loop.mp4" type="video/mp4" />
	</video>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<div class="accent-bar"></div>
		<h1>AI won't fix your business.</h1>
		<p class="subhead">Understanding your business and its marketing will…<br />and I've spent 28 years learning both.</p>
		<ul>
			{points.map((t) => (
				<li>
					<span class="check">✓</span>
					{t}
				</li>
			))}
		</ul>
		<a href="/contact/" class="cta">Book a Strategy Call →</a>
	</div>
</div>

<style>
	.hero {
		position: relative;
		min-height: 820px;
		display: flex;
		flex-direction: column;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
		background: var(--grey-400);
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(16, 16, 18, 0.55), rgba(16, 16, 18, 0.4) 40%, rgba(16, 16, 18, 0.78));
		z-index: 1;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1180px;
		width: 100%;
		margin: auto auto 0;
		padding: 40px 40px 72px;
		box-sizing: border-box;
	}
	.accent-bar {
		width: 56px;
		height: 4px;
		background: var(--orange-500);
		border-radius: 2px;
		margin-bottom: 24px;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 6rem;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #fff;
		max-width: 760px;
		margin: 0 0 20px;
	}
	.subhead {
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
		margin: 0 0 24px;
		max-width: 520px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 28px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	li {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 16px;
		font-weight: 500;
		color: #fff;
	}
	.check {
		width: 20px;
		height: 20px;
		border-radius: 999px;
		border: 1.5px solid var(--orange-500);
		color: var(--orange-500);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		flex: none;
	}
	.cta {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		background: var(--orange-500);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 14px 24px;
	}
	.cta:hover {
		background: var(--orange-600);
		color: #fff;
	}
	@media (max-width: 640px) {
		h1 {
			font-size: 3rem;
		}
		.hero-bg {
			object-position: 68% center;
		}
	}
</style>
