---
const points = [
	'Replace Agency Chaos With Leadership',
	'Align Marketing To Revenue Goals',
	'Reduce Waste With Smarter Systems And AI',
];
---
<section class="hero">
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<h1>Turn Fragmented Marketing Into Predictable Growth.</h1>
		<p>
			Fractional CMO for established businesses ($5M+ revenue) that need clear strategy, accountable
			execution, and modern automation, without hiring full-time.
		</p>
		<ul>
			{points.map((t) => <li>— {t}</li>)}
		</ul>
		<a href="#" class="cta">Book a Strategy Call→</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		background: var(--color-primary);
		color: var(--color-ink-on-dark);
		padding: 90px 48px 110px;
		text-align: center;
		overflow: hidden;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: var(--navy-900);
		opacity: 0.35;
	}
	.hero-content {
		position: relative;
		max-width: 760px;
		margin: 0 auto;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: var(--fs-display-lg);
		line-height: var(--lh-tight);
		margin: 0;
	}
	p {
		font-family: var(--font-body);
		font-size: var(--fs-body-lg);
		line-height: var(--lh-body);
		color: var(--color-ink-on-dark-muted);
		margin: 24px 0 0;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 28px 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: center;
	}
	li {
		font-family: var(--font-body);
		font-size: 15px;
	}
	.cta {
		display: inline-block;
		margin-top: 32px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 15px;
		color: var(--color-primary);
		background: var(--color-ink-on-dark);
		padding: 15px 28px;
		border-radius: var(--radius-sm);
	}
</style>
