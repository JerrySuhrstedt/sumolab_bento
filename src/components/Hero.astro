---
const points = [
	'Senior Marketing Leadership Without the Full-Time Salary',
	'A Documented System Your Team Runs Without You',
	'Qualified Leads and Real Numbers, Not Vanity Metrics',
];
---
<div class="hero">
	<picture>
		<source
			type="image/webp"
			srcset="/photos/hero-entrepreneur-office-v4-mobile.webp 800w, /photos/hero-entrepreneur-office-v4.webp 1600w"
			sizes="100vw"
		/>
		<img
			src="/photos/hero-entrepreneur-office-v4.jpg"
			srcset="/photos/hero-entrepreneur-office-v4-mobile.jpg 800w, /photos/hero-entrepreneur-office-v4.jpg 1600w"
			sizes="100vw"
			alt=""
			class="hero-bg"
			fetchpriority="high"
		/>
	</picture>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<div class="accent-bar"></div>
		<h1>Still running the marketing yourself?</h1>
		<p class="subhead">You built the company. That doesn't mean you should be its marketing department too.</p>
		<p class="subhead">I take marketing off your plate the way a real hire would… own the numbers, build the system, teach your team.</p>
		<ul>
			{points.map((t) => (
				<li>
					<span class="check">✓</span>
					{t}
				</li>
			))}
		</ul>
		<a href="/contact/" class="cta">Book a Fit Call →</a>
		<p class="cta-note">30 minutes. No deck, no pitch.</p>
	</div>
</div>

<style>
	.hero {
		position: relative;
		min-height: 820px;
		display: flex;
		flex-direction: column;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
		background: var(--grey-400);
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(16, 16, 18, 0.85), rgba(16, 16, 18, 0.6) 50%, rgba(16, 16, 18, 0.15));
		z-index: 1;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1180px;
		width: 100%;
		margin: auto auto 0;
		padding: 130px 40px 72px;
		box-sizing: border-box;
	}
	.accent-bar {
		width: 56px;
		height: 4px;
		background: var(--orange-500);
		border-radius: 2px;
		margin-bottom: 24px;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 6rem;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #fff;
		max-width: 760px;
		margin: 0 0 20px;
	}
	.subhead {
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
		margin: 0 0 15px;
		max-width: 520px;
	}
	.subhead:last-of-type {
		margin-bottom: 24px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 28px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	li {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 16px;
		font-weight: 500;
		color: #fff;
	}
	.check {
		width: 20px;
		height: 20px;
		border-radius: 999px;
		border: 1.5px solid var(--orange-500);
		color: var(--orange-500);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		flex: none;
	}
	.cta {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		background: var(--orange-500);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm);
		padding: 14px 24px;
	}
	.cta:hover {
		background: var(--orange-600);
		color: #fff;
	}
	.cta-note {
		margin: 12px 0 0;
		font-size: 14px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.7);
	}
	@media (max-width: 640px) {
		h1 {
			font-size: 3rem;
		}
		.hero-bg {
			object-position: 68% center;
		}
	}
</style>
