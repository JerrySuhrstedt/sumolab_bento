---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileMenuPanel from "../components/MobileMenuPanel.astro";

interface Props {
	title?: string;
	description?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	transparentHeader?: boolean;
}

const {
	title = "SumoLab | Fractional Marketing Leadership",
	description = "SumoLab provides fractional marketing direction and strategic consulting for established businesses ready to create focus, alignment, and accountable growth.",
	structuredData,
	transparentHeader = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredDataList = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SumoLab" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={new URL("/og-image.jpg", Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/og-image.jpg", Astro.site)} />

		{structuredDataList.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}

		<script async src="https://www.googletagmanager.com/gtag/js?id=G-MXVW8RH6LN" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-MXVW8RH6LN');
		</script>
	</head>
	<body>
		<SiteHeader transparentOnHero={transparentHeader} />
		<MobileMenuPanel />
		<slot />
		<SiteFooter />
	</body>
</html>
