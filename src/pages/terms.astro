---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
---

<Layout title="Terms | SumoLab" description="SumoLab's terms of use for this website.">
	<Section tone="plain" style="padding-top:48px">
		<p class="eyebrow-label"><span class="dot"></span>Legal</p>
		<h1 class="page-h1">Terms of Use</h1>
		<p class="lede">This is a placeholder terms page and has not yet been reviewed by legal counsel. Replace this page before launch.</p>
	</Section>

	<Section tone="white">
		<div style="max-width:720px;display:flex;flex-direction:column;gap:40px">
			<div>
				<h2 class="page-h3">Use of this site</h2>
				<p class="lede">This website is provided for informational purposes about SumoLab's services. Content on this site does not constitute a service agreement or guarantee of results.</p>
			</div>
			<div>
				<h2 class="page-h3">Engagements</h2>
				<p class="lede">Any consulting or fractional leadership engagement with SumoLab is governed by a separate, signed agreement, not by this website.</p>
			</div>
			<div>
				<h2 class="page-h3">Changes</h2>
				<p class="lede">These terms may be updated from time to time. The current version will always be available at this page.</p>
			</div>
		</div>
	</Section>
</Layout>
