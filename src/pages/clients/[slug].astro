---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { clients } from '../../data/clients';

export function getStaticPaths() {
	return clients.map((client) => ({
		params: { slug: client.slug },
		props: { client },
	}));
}

const { client } = Astro.props;
---

<Layout title={`${client.name} | SumoLab`} description={`Reports and information for ${client.name}.`} noindex>
	<Section tone="plain" style="padding-top:48px">
		<p class="eyebrow-label"><span class="dot"></span>Client report</p>
		<h1 class="page-h1">{client.name}</h1>
		<p class="lede">{client.description}</p>
	</Section>

	<Section tone="plain">
		<div class="items">
			{client.items.map((item) => (
				<div class="item">
					<h2 class="item-title">{item.title}</h2>
					{item.description && <p class="item-description">{item.description}</p>}
					<div class="embed-frame">
						<iframe src={item.embedUrl} title={item.title} loading="lazy" />
					</div>
				</div>
			))}
		</div>
	</Section>
</Layout>

<style>
	.items {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	.item-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3rem;
		margin: 0 0 8px;
	}
	.item-description {
		font-family: var(--font-body);
		font-size: 15px;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0 0 16px;
	}
	.embed-frame {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		height: 85vh;
		min-height: 600px;
	}
	.embed-frame iframe {
		width: 100%;
		height: 100%;
		border: none;
	}
</style>
