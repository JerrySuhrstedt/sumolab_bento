---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { services } from '../../data/services';
import { industries } from '../../data/industries';
---

<Layout
	title="Fractional CMO, Marketing Director & AI Consulting Services | SumoLab"
	description="Three fractional services for $5M–$50M businesses: fractional CMO leadership, a fractional marketing director for execution, and an AI marketing consultant."
>
	<PageHero
		image="/photos/services-hero-leadership.jpg"
		mobileImage="/photos/services-hero-leadership-mobile.jpg"
		imageAlt="Senior marketing leadership team planning fractional CMO, marketing director, and AI advisory services"
		eyebrow="Services"
		align="left"
		imagePosition="75% center"
	>
		<h1>Three ways to put senior leadership to work.</h1>
		<p>All three run on the same fractional principle: senior leadership without the full-time cost. Two are marketing-specific. The third looks across your whole business to find where AI actually belongs.</p>
	</PageHero>

	<Section tone="white">
		<div class="grid-3">
			{services.map((service) => <ServiceCard service={service} />)}
		</div>
	</Section>

	<Section tone="plain">
		<p class="eyebrow-label"><span class="dot"></span>Industries</p>
		<h2 class="page-h2">Six industries I know from the inside.</h2>
		<p class="lede" style="margin-top:24px;max-width:720px">Sixteen years in home building and three construction companies founded. The trades and the builders are where I have run the marketing, not just advised on it.</p>
		<div class="grid-3" style="margin-top:40px">
			{industries.map((industry) => (
				<div class="industry">
					<h3 class="page-h3"><a href={industry.href}>{industry.name}</a></h3>
					<p class="lede">{industry.line}</p>
				</div>
			))}
		</div>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Not sure which one fits your situation?</h2>
			<LeadForm />
		</div>
	</Section>
</Layout>

<style>
	.industry {
		border-top: 3px solid var(--orange-500);
		padding-top: 20px;
	}
	.industry a {
		text-decoration: none;
	}
	.industry a:hover {
		color: var(--orange-600);
	}
</style>
