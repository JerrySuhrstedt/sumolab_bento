---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import CaseStudyMetrics from '../components/CaseStudyMetrics.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FounderFeatures from '../components/FounderFeatures.astro';
import FAQCTA from '../components/FAQCTA.astro';
import { contact } from '../data/contact';
import { cities } from '../data/cities';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'SumoLab',
	description: 'SumoLab provides fractional CMO and marketing leadership for established businesses generating $5M+ in annual revenue.',
	url: 'https://sumolab-bento.sumolab.workers.dev',
	telephone: contact.phoneHref ?? undefined,
	address: contact.location
		? {
				'@type': 'PostalAddress',
				addressLocality: contact.location.split(',')[0]?.trim(),
				addressRegion: 'AZ',
				addressCountry: 'US',
			}
		: undefined,
	areaServed: cities.map((city) => ({ '@type': 'City', name: `${city.name}, ${city.state}` })),
};
---
<Layout
	title="SumoLab | Fractional CMO & Marketing Leadership"
	description="Senior marketing leadership without the full-time cost. SumoLab brings 28 years of operator experience and precise AI strategy to established businesses ready for real growth."
	structuredData={structuredData}
	transparentHeader
>
	<Hero />
	<div class="content-wrap">
		<ProblemSolution />
		<CaseStudyMetrics />
		<BenefitsSection />
		<ServicesOverview />
		<TestimonialsSection />
		<FounderFeatures />
		<FAQCTA />
	</div>
</Layout>

<style>
	.content-wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 64px 40px;
	}
</style>
