---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import CaseStudyMetrics from '../components/CaseStudyMetrics.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FounderFeatures from '../components/FounderFeatures.astro';
import FAQCTA from '../components/FAQCTA.astro';
import { contact } from '../data/contact';
import { cities } from '../data/cities';
import { founder } from '../data/founder';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'SumoLab',
	description: 'SumoLab provides fractional CMO services and senior marketing leadership for established businesses generating $5M–$50M in annual revenue.',
	url: 'https://sumolab.co',
	telephone: contact.phoneHref ?? undefined,
	email: contact.email ?? undefined,
	address: contact.location
		? {
				'@type': 'PostalAddress',
				addressLocality: contact.location.split(',')[0]?.trim(),
				addressRegion: 'AZ',
				addressCountry: 'US',
			}
		: undefined,
	areaServed: [
		...cities.map((city) => ({ '@type': 'City', name: `${city.name}, ${city.state}` })),
		{ '@type': 'Country', name: 'United States' },
	],
	sameAs: founder.linkedinUrl ? [founder.linkedinUrl] : undefined,
	founder: {
		'@type': 'Person',
		name: founder.name ?? 'Jerry Suhrstedt',
		jobTitle: 'Founder & Fractional CMO',
		sameAs: founder.linkedinUrl ?? undefined,
		worksFor: { '@type': 'Organization', name: 'SumoLab' },
	},
	knowsAbout: [
		'Fractional CMO services',
		'Marketing strategy',
		'Lead generation systems',
		'AI marketing implementation',
		'CRM and marketing automation',
		'Brand positioning and messaging',
	],
};
---
<Layout
	title="Hire a Fractional CMO for Your $5M–$50M Business | SumoLab"
	description="Hire a fractional CMO backed by 28 years of operator experience. SumoLab gives $5M–$50M businesses senior marketing leadership without the full-time cost."
	structuredData={structuredData}
	transparentHeader
>
	<Hero />
	<div class="content-wrap">
		<ProblemSolution />
		<CaseStudyMetrics />
		<BenefitsSection />
		<ServicesOverview />
		<TestimonialsSection />
		<FounderFeatures />
		<FAQCTA />
	</div>
</Layout>

<style>
	.content-wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 64px 40px;
	}
</style>
