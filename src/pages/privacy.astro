---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
---

<Layout
	title="Privacy Policy | SumoLab"
	description="SumoLab's privacy policy, covering how information submitted through this site is collected and used."
>
	<Section tone="plain" style="padding-top:48px">
		<p class="eyebrow-label"><span class="dot"></span>Legal</p>
		<h1 class="page-h1">Privacy Policy</h1>
		<p class="lede">This is a placeholder policy and has not yet been reviewed by legal counsel. Replace this page before collecting any real visitor data in production.</p>
	</Section>

	<Section tone="white">
		<div style="max-width:720px;display:flex;flex-direction:column;gap:40px">
			<div>
				<h2 class="page-h3">Information I collect</h2>
				<p class="lede">When you submit the contact form on this site, I collect the information you provide, including your name, email address, company, and details about your marketing challenge.</p>
			</div>
			<div>
				<h2 class="page-h3">How I use it</h2>
				<p class="lede">I use this information only to evaluate fit and follow up about a potential engagement. I do not sell or share your information with third parties for marketing purposes.</p>
			</div>
			<div>
				<h2 class="page-h3">Contact</h2>
				<p class="lede">Questions about this policy can be directed to SumoLab once a contact method is published on this site.</p>
			</div>
		</div>
	</Section>
</Layout>
