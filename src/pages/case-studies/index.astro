---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import PrimaryCTA from '../../components/PrimaryCTA.astro';
import { caseStudies } from '../../data/case-studies';
---

<Layout
	title="Case Studies | SumoLab"
	description="Real engagements across home building, medical supply, and enterprise mobility — the problem going in, the decision that changed it, and the result it produced."
>
	<PageHero
		image="/photos/case-studies-hero.jpg"
		eyebrow="Case Studies"
		align="left"
		imagePosition="80% center"
	>
		<h1>Proof, in the numbers.</h1>
		<p>Real engagements across home building, medical supply, and enterprise mobility — the problem going in, the decision that changed it, and the result it produced.</p>
	</PageHero>

	<Section tone="white">
		<div class="grid-2">
			{caseStudies.map((cs) => (
				<a href={`/case-studies/${cs.slug}/`} class="cs-card">
					<img src={cs.icon} alt="" class="cs-icon" aria-hidden="true" width="40" height="40" />
					<p class="cs-client">{cs.client}</p>
					<h2 class="page-h3">{cs.title}</h2>
					<p class="lede">{cs.summary}</p>
					<span class="cs-link">Read the case study <span aria-hidden="true">→</span></span>
				</a>
			))}
		</div>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Want results like these for your business?</h2>
			<PrimaryCTA />
		</div>
	</Section>
</Layout>

<style>
	.cs-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: 32px;
		color: var(--text-primary);
		text-decoration: none;
		transition: border-color 0.15s;
	}
	.cs-card:hover {
		border-color: var(--orange-500);
		color: var(--text-primary);
	}
	.cs-icon {
		width: 40px;
		height: 40px;
		display: block;
		margin-bottom: 8px;
	}
	.cs-client {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-secondary);
		margin: 0;
	}
	.cs-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 14px;
		color: var(--orange-500);
		margin-top: auto;
	}
</style>
