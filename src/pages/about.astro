---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import LeadForm from '../components/LeadForm.astro';
import { founder } from '../data/founder';
---

<Layout
	title="About | SumoLab"
	description="Most AI advice comes from people who've never had to make payroll. Mine comes from 26 years of building and running businesses, and going deep on AI."
>
	<PageHero
		image="/photos/about-hero.jpg"
		mobileImage="/photos/about-hero-mobile.jpg"
		imageAlt="Jerry Suhrstedt, fractional CMO and founder of SumoLab, working in his Chandler, Arizona office"
		eyebrow="About"
		align="left"
		imagePosition="65% top"
	>
		<h1>Marketing that runs.<br />Operations that scale.<br />AI that pays.</h1>
		<p>Most AI advice comes from people who've never had to make payroll. Mine comes from 26 years of building and running businesses, and going deep on AI.</p>
	</PageHero>

	<Section tone="white">
		<p class="eyebrow-label"><span class="dot"></span>What is SumoLab?</p>
		<h2 class="page-h2">A laboratory for business growth.</h2>
		<div class="two-col" style="margin-top:40px;align-items:start">
			<div>
				<p class="lede">Most companies do not have a marketing problem. They have a strategy problem. They run ads, launch campaigns, redesign websites, and post on social media, but without a clear strategy, those activities produce inconsistent results. SumoLab exists to solve that problem.</p>
				<p class="lede" style="margin-top:14px">Growth starts with strategy: positioning, messaging, market focus, and lead generation systems, built before execution. Instead of random activities, companies operate with a structured marketing engine that supports sales and drives revenue.</p>
			</div>
			<div class="definition-box">
				<p class="def-label">Definition</p>
				<p class="def-text">SumoLab, noun: a strategic growth laboratory where marketing, messaging, and systems are designed, tested, and refined to produce measurable business growth.</p>
			</div>
		</div>
	</Section>

	<Section tone="plain">
		<p class="eyebrow-label"><span class="dot"></span>Founder</p>
		<h2 class="page-h2">Who's behind SumoLab.</h2>
		<div class="two-col founder-grid" style="margin-top:40px;align-items:start">
			<div>
				<img
					src={founder.headshotSrc ?? undefined}
					alt={founder.name && founder.title ? `${founder.name}, ${founder.title}` : founder.name ?? 'Founder'}
					class="founder-photo"
					loading="lazy"
				/>
			</div>
			<div>
				<p class="founder-name">{founder.name}</p>
				<p class="founder-title">{founder.title}</p>
				<div style="margin-top:24px;display:flex;flex-direction:column;gap:16px">
					{founder.longBio.map((para) => <p class="lede">{para}</p>)}
				</div>
			</div>
		</div>
	</Section>

	<Section tone="white">
		<p class="eyebrow-label"><span class="dot"></span>Expertise</p>
		<h2 class="page-h2">Where he focuses.</h2>
		<div class="grid-2" style="margin-top:48px">
			{founder.expertise.map((item) => (
				<div class="expertise-item">
					<span class="expertise-dot" aria-hidden="true"></span>
					<span>{item}</span>
				</div>
			))}
		</div>
		<p class="lede" style="margin-top:32px">Industries served: {founder.industries.join(', ')}.</p>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Ready to talk about your marketing leadership?</h2>
			<LeadForm />
		</div>
	</Section>
</Layout>

<style>
	.definition-box {
		background: var(--ink-950);
		border-radius: var(--radius-md);
		padding: 32px;
		color: #fff;
	}
	.def-label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin: 0 0 12px;
	}
	.def-text {
		font-size: 1.05rem;
		line-height: 1.55;
		margin: 0;
	}
	.founder-photo {
		width: 100%;
		max-width: 360px;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: var(--radius-md);
	}
	.founder-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
		margin: 0 0 4px;
	}
	.founder-title {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin: 0;
	}
	.expertise-item {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 14px 0;
		border-bottom: 1px solid var(--hairline);
		font-size: 15px;
	}
	.expertise-dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--orange-500);
		margin-top: 6px;
		flex: none;
	}
</style>
