---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import LeadForm from '../../components/LeadForm.astro';
import { portfolioProjects } from '../../data/portfolio';
---

<Layout
	title="Portfolio | SumoLab"
	description="Hi, I'm Jerry Suhrstedt. A sample of my marketing strategy work, personally ideated, designed, and built, drawn from 26 years of building and running businesses. The problem, the action, and the result for each project."
>
	<Section tone="plain" style="padding-top:68px">
		<p class="eyebrow-label"><span class="dot"></span>Portfolio</p>
		<h1 class="page-h1">Selected work.</h1>
		<p class="lede">
			<strong>Hi, I'm Jerry Suhrstedt.</strong> Here's a sample of my marketing strategy work. Everything on this page, I personally
			ideated, designed, and built, drawing on 26 years of building and running businesses. Every project below
			shows the problem, what I did about it, and what happened. If your time is limited, the projects marked
			with a star are the ones to look at first.
		</p>
	</Section>

	<Section tone="plain">
		<div class="portfolio-grid">
			{portfolioProjects.map((project) => (
				<a href={`/jerry/${project.slug}/`} class="portfolio-card">
					<div class="thumb">
						{project.thumb ? (
							<img src={project.thumb} alt={project.name} loading="lazy" />
						) : (
							<div class="thumb-fallback">{project.category}</div>
						)}
						{project.featured && (
							<span class="star-badge" title="Start here" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.6 7.1.7-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7-5.4-4.7 7.1-.7z" /></svg>
							</span>
						)}
					</div>
					<div class="body">
						<p class="category">
							{project.category}
							{project.sample && <span class="sample-tag">Sample</span>}
						</p>
						<h2 class="name">{project.name}</h2>
						<p class="teaser">{project.problem}</p>
					</div>
				</a>
			))}
		</div>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Want to talk about a project like this for your business?</h2>
			<LeadForm />
		</div>
	</Section>
</Layout>

<style>
	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	.portfolio-card {
		display: block;
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		color: inherit;
		transition: border-color 0.15s ease;
	}
	.portfolio-card:hover {
		border-color: var(--border-strong, var(--orange-500));
		color: inherit;
	}
	.thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--surface-sunken);
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.thumb::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		transition: background-color 0.2s ease;
		z-index: 1;
	}
	.portfolio-card:hover .thumb::after {
		background: rgba(0, 0, 0, 0);
	}
	.star-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		z-index: 2;
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--white);
		border-radius: 999px;
		color: var(--orange-500);
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
	}
	.star-badge svg {
		width: 18px;
		height: 18px;
	}
	.thumb-fallback {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 24px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}
	.body {
		padding: 24px;
	}
	.category {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--orange-500);
		margin: 0 0 10px;
	}
	.sample-tag {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 10.5px;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--text-secondary);
		background: var(--surface-sunken);
		border-radius: 999px;
		padding: 3px 9px;
	}
	.name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3rem;
		line-height: 1.25;
		margin: 0 0 10px;
	}
	.teaser {
		font-family: var(--font-body);
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 900px) {
		.portfolio-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 640px) {
		.portfolio-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
