---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import LeadForm from '../../components/LeadForm.astro';
import { insights } from '../../data/insights';
import { founder } from '../../data/founder';

export function getStaticPaths() {
	return insights.map((insight) => ({
		params: { slug: insight.slug },
		props: { insight },
	}));
}

const { insight } = Astro.props;

const publishedDate = new Date(insight.publishedAt).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});

const articleUrl = new URL(`/blog/${insight.slug}/`, Astro.site).toString();
const structuredData: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: insight.title,
		description: insight.excerpt,
		image: new URL(insight.imageSrc, Astro.site).toString(),
		datePublished: insight.publishedAt,
		author: {
			'@type': 'Person',
			name: founder.name,
			jobTitle: 'Fractional CMO',
			url: new URL('/about', Astro.site).toString(),
		},
		publisher: {
			'@type': 'Organization',
			name: 'SumoLab',
			url: Astro.site?.toString(),
			logo: {
				'@type': 'ImageObject',
				url: new URL('/logos/sumolab-bento.svg', Astro.site).toString(),
			},
		},
		mainEntityOfPage: articleUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
			{ '@type': 'ListItem', position: 2, name: 'Insights', item: new URL('/blog/', Astro.site).toString() },
			{ '@type': 'ListItem', position: 3, name: insight.title, item: articleUrl },
		],
	},
];

if (insight.slug === 'trellivance') {
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'DefinedTerm',
		name: 'Trellivance',
		description:
			'Trellivance (noun, treh-LIV-ance): the point at which a message becomes genuinely relevant — the moment a marketing message stops being about the company and becomes about the person reading it. Coined by Jerry Suhrstedt of SumoLab.',
		url: articleUrl,
	});
}
---

<Layout title={insight.seoTitle ?? `${insight.title} | SumoLab Insights`} description={insight.excerpt} structuredData={structuredData}>
	<PageHero
		image={insight.imageSrc}
		imageAlt={insight.title}
		eyebrow={`${insight.category} · ${publishedDate}`}
		align="left"
	>
		<h1>{insight.title}</h1>
		<p>{insight.excerpt}</p>
	</PageHero>

	<Section tone="white">
		<div class="article-wrap">
			<div class="article-header">
				<p class="page-h2" style="margin:0">{insight.title}</p>
				<p class="lede">{insight.excerpt}</p>
				<div class="byline">
					{founder.headshotSrc && (
						<img
							src="/team/jerry-suhrstedt-avatar.webp"
							alt={founder.name && founder.title ? `${founder.name}, ${founder.title}` : founder.name ?? 'Author'}
							class="byline-avatar"
							loading="lazy"
							width="48"
							height="48"
						/>
					)}
					<div>
						<p class="byline-name">{founder.name}</p>
						<p class="byline-date">{publishedDate}</p>
					</div>
				</div>
			</div>
			<div class="article-body">
				{insight.body.map((para) =>
					para.startsWith('<h3') || para.startsWith('<h2')
						? <Fragment set:html={para} />
						: <p class="lede" set:html={para}></p>
				)}
				{insight.keyPoints && (
					<ul class="dot-list key-points">
						{insight.keyPoints.map((point) => (
							<li><span class="dot" aria-hidden="true"></span>{point}</li>
						))}
					</ul>
				)}
			</div>
		</div>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Want senior marketing leadership on your team?</h2>
			<LeadForm />
		</div>
	</Section>
</Layout>

<style>
	.article-wrap {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	.article-header {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-bottom: 32px;
		border-bottom: 1px solid var(--hairline);
	}
	.article-header .lede {
		font-size: 1.4rem;
		font-weight: 500;
	}
	.byline {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 8px;
	}
	.byline-avatar {
		width: 48px;
		height: 48px;
		border-radius: 999px;
		object-fit: cover;
	}
	.byline-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 15px;
		margin: 0;
	}
	.byline-date {
		font-size: 13px;
		color: var(--text-secondary);
		margin: 0;
	}
	.article-body {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.article-body :global(h2),
	.article-body :global(h3) {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.3;
		color: var(--text-primary);
		margin: 12px 0 0;
	}
	.key-points {
		margin-top: 16px;
		padding-top: 32px;
		border-top: 1px solid var(--hairline);
	}
</style>
