---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { insights } from '../../data/insights';

const categories = [
	'Strategy & Leadership',
	'Marketing & Growth',
	'Sales & CRM',
	'Systems & Automation',
	'Case Studies',
];
---

<Layout
	title="Insights | SumoLab"
	description="Notes on strategy, leadership, and technology for established businesses, written by an operator who's actually done the work."
>
	<PageHero
		image="/photos/insights-hero.jpg"
		eyebrow="Insights"
		align="left"
		imagePosition="80% center"
	>
		<h1>Practical thinking on business, growth, and AI.</h1>
		<p>Notes on strategy, leadership, and technology for established businesses — written by an operator who's actually done the work.</p>
	</PageHero>

	<div class="filter-bar">
		<div class="filter-inner">
			<button type="button" data-category="all" class="filter-btn active">All</button>
			{categories.map((cat) => (
				<button type="button" data-category={cat} class="filter-btn">{cat}</button>
			))}
		</div>
	</div>

	<Section tone="white">
		<div class="grid-3" id="insights-grid">
			{insights.map((article) => (
				<a href={`/blog/${article.slug}/`} data-category={article.category} class="article-card">
					<div class="article-img-wrap">
						<img src={article.imageSrc} alt="" class="article-img" loading="lazy" />
					</div>
					<div class="article-body">
						<p class="article-cat">{article.category}</p>
						<h2 class="page-h3">{article.title}</h2>
						<p class="lede">{article.excerpt}</p>
					</div>
				</a>
			))}
		</div>
	</Section>
</Layout>

<style>
	.filter-bar {
		background: #fff;
		border-bottom: 1px solid var(--hairline);
	}
	.filter-inner {
		max-width: 1180px;
		margin: 0 auto;
		padding: 16px 40px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.filter-btn {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 13px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 8px 16px;
		background: transparent;
		color: var(--text-primary);
		cursor: pointer;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.filter-btn:hover {
		border-color: var(--orange-500);
		color: var(--orange-500);
	}
	.filter-btn.active {
		background: var(--ink-950);
		color: #fff;
		border-color: var(--ink-950);
	}
	.article-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		transition: border-color 0.15s;
	}
	.article-card:hover {
		border-color: var(--orange-500);
		color: var(--text-primary);
	}
	.article-img-wrap {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--surface-sunken);
	}
	.article-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}
	.article-card:hover .article-img {
		transform: scale(1.04);
	}
	.article-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
	}
	.article-cat {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-secondary);
		margin: 0;
	}
	@media (max-width: 640px) {
		.filter-inner {
			padding: 12px 20px;
		}
	}
</style>

<script>
	function initFilter() {
		const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
		const cards = document.querySelectorAll<HTMLAnchorElement>('#insights-grid > a');
		if (!buttons.length || !cards.length) return;

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const cat = btn.dataset.category;
				buttons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				cards.forEach((card) => {
					const show = cat === 'all' || card.dataset.category === cat;
					(card as HTMLElement).style.display = show ? '' : 'none';
				});
			});
		});
	}

	initFilter();
	document.addEventListener('astro:page-load', initFilter);
</script>
