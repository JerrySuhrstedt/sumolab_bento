---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { insights } from '../../data/insights';

const sortedInsights = [...insights].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));

const categories = [
	'Strategy & Leadership',
	'Marketing & Growth',
	'Sales & CRM',
	'Systems & Automation',
	'Case Studies',
];
---

<Layout
	title="Insights | SumoLab"
	description="Notes on strategy, leadership, and technology for established businesses, written by an operator who's actually done the work."
>
	<PageHero
		image="/photos/insights-hero.jpg"
		mobileImage="/photos/insights-hero-mobile.jpg"
		imageAlt="Business strategy notes and marketing planning materials laid out for review"
		eyebrow="Insights"
		align="left"
		imagePosition="80% center"
	>
		<h1>Practical thinking on business, growth, and AI.</h1>
		<p>Notes on strategy, leadership, and technology for established businesses — written by an operator who's actually done the work.</p>
	</PageHero>

	<div class="filter-bar">
		<div class="filter-inner">
			<button type="button" data-category="all" class="filter-btn active">All</button>
			{categories.map((cat) => (
				<button type="button" data-category={cat} class="filter-btn">{cat}</button>
			))}
			<input
				type="search"
				id="article-search"
				class="search-input"
				placeholder="Search articles…"
				aria-label="Search articles"
			/>
		</div>
	</div>

	<Section tone="white">
		<div class="grid-3" id="insights-grid">
			{sortedInsights.map((article) => (
				<a href={`/blog/${article.slug}/`} data-category={article.category} class="article-card">
					<div class="article-img-wrap">
						<img src={article.imageSrc} alt={article.title} class="article-img" loading="lazy" />
					</div>
					<div class="article-body">
						<p class="article-cat">{article.category}</p>
						<h2 class="page-h3">{article.title}</h2>
						<p class="lede">{article.excerpt}</p>
					</div>
				</a>
			))}
		</div>
		<p id="no-results" class="lede" style="display:none">No articles match your search.</p>
	</Section>
</Layout>

<style>
	.filter-inner {
		max-width: 1180px;
		margin: 0 auto;
		padding: 16px 40px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}
	.search-input {
		font-family: var(--font-body);
		font-size: 14px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 8px 16px;
		background: #fff;
		color: var(--text-primary);
		min-width: 220px;
		margin-left: auto;
		transition: border-color 0.15s;
	}
	.search-input:focus {
		outline: none;
		border-color: var(--orange-500);
	}
	.search-input::placeholder {
		color: var(--text-muted);
	}
	.filter-btn {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 13px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 8px 16px;
		background: transparent;
		color: var(--text-primary);
		cursor: pointer;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.filter-btn:hover {
		border-color: var(--orange-500);
		color: var(--orange-500);
	}
	.filter-btn.active {
		background: var(--ink-950);
		color: #fff;
		border-color: var(--ink-950);
	}
	.article-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		transition: border-color 0.15s;
	}
	.article-card:hover {
		border-color: var(--orange-500);
		color: var(--text-primary);
	}
	.article-img-wrap {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--surface-sunken);
	}
	.article-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}
	.article-card:hover .article-img {
		transform: scale(1.04);
	}
	.article-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
	}
	.article-cat {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-secondary);
		margin: 0;
	}
	@media (max-width: 640px) {
		.filter-inner {
			padding: 12px 20px;
		}
	}
</style>

<script>
	function initFilter() {
		const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
		const cards = document.querySelectorAll<HTMLAnchorElement>('#insights-grid > a');
		const search = document.querySelector<HTMLInputElement>('#article-search');
		const noResults = document.getElementById('no-results');
		if (!buttons.length || !cards.length) return;

		let activeCategory = 'all';

		const applyFilters = () => {
			const query = (search?.value ?? '').trim().toLowerCase();
			let visible = 0;
			cards.forEach((card) => {
				const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
				const matchesQuery = !query || (card.textContent ?? '').toLowerCase().includes(query);
				const show = matchesCategory && matchesQuery;
				(card as HTMLElement).style.display = show ? '' : 'none';
				if (show) visible++;
			});
			if (noResults) noResults.style.display = visible ? 'none' : '';
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				activeCategory = btn.dataset.category ?? 'all';
				buttons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				applyFilters();
			});
		});

		search?.addEventListener('input', applyFilters);
	}

	initFilter();
	document.addEventListener('astro:page-load', initFilter);
</script>
