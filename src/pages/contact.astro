---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PrimaryCTA from '../components/PrimaryCTA.astro';

const callCovers = [
	'Where your marketing stands today, and where the gaps are',
	'Whether a Fractional Marketing Director or focused consulting fits your situation',
	'What an engagement would actually look like for your business',
	'A straight answer on fit, in either direction',
];
---

<Layout
	title="Book a Strategy Call | SumoLab"
	description="Schedule a strategy call with SumoLab. Tell us about your business and we'll follow up to discuss whether senior marketing leadership is the right fit."
>
	<Section tone="plain" style="padding-top:48px">
		<p class="eyebrow-label"><span class="dot"></span>Contact</p>
		<h1 class="page-h1">Book a strategy call.</h1>
		<p class="lede">Tell us about your business below. This is a practical conversation about your marketing, not a sales pitch, and we'll tell you honestly if SumoLab isn't the right fit.</p>
	</Section>

	<Section tone="white">
		<div class="two-col" style="align-items:start">
			<div class="form-col">
				<script is:inline src="https://js-na2.hsforms.net/forms/embed/244692534.js" defer></script>
				<div
					class="hs-form-frame"
					data-region="na2"
					data-form-id="f9445925-a2ec-4b85-82d4-45192a42e60d"
					data-portal-id="244692534"
				>
				</div>
			</div>
			<div style="padding-top:4px">
				<p class="covers-label">What the call covers</p>
				<ul class="dot-list" style="margin-top:20px">
					{callCovers.map((item) => (
						<li><span class="dot" aria-hidden="true"></span>{item}</li>
					))}
				</ul>
				<p class="lede" style="margin-top:32px">SumoLab is built for established businesses generating $5M+ in annual revenue. If that's not quite you yet, we'll say so, and point you in a more useful direction if we can.</p>
			</div>
		</div>
	</Section>
</Layout>

<style>
	.covers-label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-secondary);
		margin: 0 0 4px;
	}
	.form-col {
		min-width: 0;
	}
</style>
