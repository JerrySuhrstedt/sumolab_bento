---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import LeadForm from '../../components/LeadForm.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { drafts } from '../../data/drafts';
import { insights } from '../../data/insights';
import { founder } from '../../data/founder';

export function getStaticPaths() {
	return drafts.map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}

const { insight } = Astro.props;
const publishedDate = new Date(insight.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// Draft QA: the same checks used on every published page, shown only on the draft.
const plain = insight.body.map((p) => p.replace(/<[^>]+>/g, ' ')).join(' ').replace(/\s+/g, ' ');
const kw = (insight.targetKeyword ?? '').toLowerCase();
const h3s = insight.body.filter((p) => /^<h[23]/.test(p)).map((p) => p.replace(/<[^>]+>/g, ''));
const firstTwo = (plain.match(/[^.!?]+[.!?]/g) ?? []).slice(0, 2).join(' ').toLowerCase();
const banned = ['delve', 'testament', 'beacon', 'revolutioniz', 'moreover', 'furthermore', 'tapestry', 'crucial', 'paramount', 'digital age'];
const links = [...new Set([...insight.body.join('\n').matchAll(/href="(\/[^"]*)"/g)].map((m) => m[1]))];
const knownPaths = new Set([...insights.map((i) => `/blog/${i.slug}/`), '/blog/', '/services/fractional-cmo/', '/services/fractional-marketing-director/', '/services/fractional-ai-advisor/', '/marketing-consultant-for-small-business/', '/marketing-for-home-builders/', '/marketing-for-construction-companies/', '/marketing-for-remodelers/', '/milliondollarlp/', '/case-studies/', '/contact/', '/about/', '/fractional-cmo-near-me/']);
const words = plain.split(/\s+/).filter(Boolean).length;
const checks = [
	{ label: 'Keyword set', ok: !!kw, detail: kw || 'no targetKeyword on the draft' },
	{ label: 'Keyword in title', ok: !!kw && insight.title.toLowerCase().includes(kw), detail: insight.title },
	{ label: 'Keyword in first two sentences', ok: !!kw && firstTwo.includes(kw), detail: firstTwo.slice(0, 140) + '…' },
	{ label: 'Keyword in an H2/H3', ok: !!kw && h3s.some((h) => h.toLowerCase().includes(kw)), detail: `${h3s.length} headings` },
	{ label: 'No em dashes', ok: !insight.body.join('').includes('—') && !insight.excerpt.includes('—') && !insight.title.includes('—'), detail: `${(insight.body.join('').match(/—/g) ?? []).length} found` },
	{ label: 'No banned words', ok: !banned.some((b) => plain.toLowerCase().includes(b)), detail: banned.filter((b) => plain.toLowerCase().includes(b)).join(', ') || 'clean' },
	{ label: 'Internal links resolve', ok: links.every((l) => knownPaths.has(l) || l.startsWith('/jerry/') || l.startsWith('/case-studies/') || l.startsWith('/blog/')), detail: `${links.length} internal links` },
	{ label: 'Length 900 to 1,600 words', ok: words >= 900 && words <= 1600, detail: `${words} words` },
	{ label: 'Meta description under 160', ok: insight.excerpt.length <= 160, detail: `${insight.excerpt.length} chars` },
	{ label: 'FAQ block, 3 to 5 questions', ok: !!insight.faqs && insight.faqs.length >= 3 && insight.faqs.length <= 5, detail: `${insight.faqs?.length ?? 0} questions` },
	{ label: 'Snippet answer near the top', ok: h3s.length > 0 && /\?$/.test(h3s[0] ?? '') || h3s.slice(0, 2).some((h) => /\?$/.test(h)), detail: 'first or second heading is a question' },
];
const faqSchema = insight.faqs && insight.faqs.length > 0 ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: insight.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) }] : [];
---

<Layout title={`DRAFT · ${insight.title}`} description={insight.excerpt} noindex={true} structuredData={faqSchema}>
	<div class="draft-bar">
		<strong>Draft preview.</strong> Not indexed, not in the sitemap, not linked anywhere. Final approval moves it to /blog/{insight.slug}/.
		<a href="/admin/">Back to the pipeline</a>
	</div>

	<PageHero image={insight.imageSrc} imageAlt={insight.title} eyebrow={`${insight.category} · ${publishedDate}`} align="left">
		<h1>{insight.title}</h1>
		<p>{insight.excerpt}</p>
	</PageHero>

	<Section tone="white">
		<div class="article-wrap">
			<div class="article-header">
				<p class="page-h2" style="margin:0">{insight.title}</p>
				<p class="lede">{insight.excerpt}</p>
				<div class="byline">
					<img src="/team/jerry-suhrstedt-avatar.webp" alt={founder.name ?? 'Author'} class="byline-avatar" width="48" height="48" />
					<div><p class="byline-name">{founder.name}</p><p class="byline-date">{publishedDate}</p></div>
				</div>
			</div>
			<div class="article-body">
				{insight.body.map((para) => (para.startsWith('<h3') || para.startsWith('<h2') ? <Fragment set:html={para} /> : <p class="lede" set:html={para}></p>))}
				{insight.keyPoints && (
					<ul class="dot-list key-points">{insight.keyPoints.map((point) => <li><span class="dot" aria-hidden="true"></span>{point}</li>)}</ul>
				)}
			</div>
		</div>
	</Section>

	{insight.faqs && insight.faqs.length > 0 && (
		<Section tone="white">
			<div class="article-wrap">
				<p class="eyebrow-label"><span class="dot"></span>Questions people ask</p>
				<h2 class="page-h3" style="margin-bottom:16px">Straight answers on {insight.targetKeyword ?? 'this'}</h2>
				<FaqAccordion items={insight.faqs} />
			</div>
		</Section>
	)}

	<Section tone="plain">
		<div class="qa">
			<p class="eyebrow-label"><span class="dot"></span>Draft QA</p>
			<h2 class="page-h3">{checks.filter((c) => c.ok).length} of {checks.length} checks pass</h2>
			<ul>
				{checks.map((c) => <li class:list={[{ ok: c.ok, bad: !c.ok }]}><span class="mark">{c.ok ? '✓' : '✕'}</span><strong>{c.label}</strong><span class="detail">{c.detail}</span></li>)}
			</ul>
		</div>
	</Section>

	<Section tone="ink">
		<div class="card-cta-row">
			<h2 class="page-h2" style="color:#fff;margin:0">Want senior marketing leadership on your team?</h2>
			<LeadForm />
		</div>
	</Section>
</Layout>

<style>
	.draft-bar { position: sticky; top: 0; z-index: 50; background: var(--orange-500); color: #fff; padding: 10px 24px; font-size: 14px; display: flex; gap: 14px; align-items: center; justify-content: center; flex-wrap: wrap; }
	.draft-bar a { color: #fff; font-weight: 600; }
	.article-wrap { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px; }
	.article-header { display: flex; flex-direction: column; gap: 16px; padding-bottom: 32px; border-bottom: 1px solid var(--hairline); }
	.article-header .lede { font-size: 1.4rem; font-weight: 500; }
	.byline { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
	.byline-avatar { width: 48px; height: 48px; border-radius: 999px; object-fit: cover; }
	.byline-name { font-family: var(--font-display); font-weight: 600; font-size: 15px; margin: 0; }
	.byline-date { font-size: 13px; color: var(--text-secondary); margin: 0; }
	.article-body { display: flex; flex-direction: column; gap: 20px; }
	.article-body :global(h2), .article-body :global(h3) { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.3; color: var(--text-primary); margin: 12px 0 0; }
	.key-points { margin-top: 16px; padding-top: 32px; border-top: 1px solid var(--hairline); }
	.qa { max-width: 720px; margin: 0 auto; }
	.qa ul { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
	.qa li { display: grid; grid-template-columns: 24px 260px 1fr; gap: 10px; align-items: baseline; font-size: 14.5px; }
	.qa li .mark { font-weight: 700; }
	.qa li.ok .mark { color: #1e7b3a; }
	.qa li.bad .mark { color: #b3261e; }
	.qa li .detail { color: var(--text-secondary); font-size: 13.5px; word-break: break-word; }
	@media (max-width: 640px) { .qa li { grid-template-columns: 24px 1fr; } .qa li .detail { grid-column: 2; } }
</style>
